+/*
+ * Madeira: in-process virtual XInput controller (PE side).
+ *
+ * Madeira.app runs the guest inside its own process (see the app's
+ * WineProcessBridge.m, wine_process_thread) and already produces one merged
+ * controller frame from two sources that both live in the app: the on-screen
+ * pad, and a paired Bluetooth/MFi pad read through GameController. This
+ * header is the ABI across which that frame reaches xinput1_4.dll.
+ *
+ * It is deliberately not a HID device. This tree ships no winedevice.exe, no
+ * plugplay.exe and no winebus.sys, and autostarting winebus on iOS was
+ * measured to wedge the driver host behind the service startup lock, so the
+ * usual route -- present a HID gamepad, let winebus.sys enumerate it and
+ * hidclass/winexinput.sys turn it into an XInput device -- is closed here. A
+ * unix call into the app needs none of those pieces and cannot wedge a
+ * service that is never started.
+ *
+ * The table itself lives in the app (app/Madeira/MadeiraXInput.c) and is
+ * registered by module name in build/ntdll-unix/virtual_ios.c
+ * load_builtin_unixlib. The app's mirror of this file is the header
+ * app/Madeira/MadeiraXInput.h -- keep the two in sync.
+ */
+
+#ifndef MADEIRA_XINPUT_H
+#define MADEIRA_XINPUT_H
+
+/* Fixed-width fields on purpose: the PE side is compiled for aarch64 or
+ * arm64ec, the app side for arm64, and this struct crosses between them. */
+struct madeira_pad_state
+{
+    unsigned int packet;         /* bumps only when a field below changes */
+    unsigned short buttons;      /* XINPUT_GAMEPAD_* */
+    unsigned char left_trigger;  /* XINPUT_GAMEPAD.bLeftTrigger */
+    unsigned char right_trigger; /* XINPUT_GAMEPAD.bRightTrigger */
+    short thumb_lx, thumb_ly, thumb_rx, thumb_ry;
+};
+
+struct madeira_pad_rumble
+{
+    unsigned short left, right;  /* XINPUT_VIBRATION motors, 0..65535 */
+};
+
+enum madeira_pad_funcs
+{
+    /* const struct madeira_pad_state * --> STATUS_SUCCESS when the app has a
+     * controller to report, STATUS_DEVICE_NOT_CONNECTED when it has none
+     * (the on-screen pad is switched off and no physical pad is paired). */
+    madeira_pad_get_state = 0,
+    /* const struct madeira_pad_rumble * --> best effort, always succeeds. */
+    madeira_pad_set_rumble,
+    madeira_pad_funcs_count,
+};
+
+#endif /* MADEIRA_XINPUT_H */
