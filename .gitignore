# Build output
build/
build-*/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dSYM/
compile_commands.json
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
.cache/
ccache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.xcarchive

# Runtime state that must never be committed: these are per-user, per-device,
# and can contain absolute paths from the machine that produced them.
cache/*
!cache/.gitkeep
profiles/*/
!profiles/defaults/
!profiles/README.md
*.log

# Fetched third-party sources and local Wine prefixes are user-supplied.
third_party/src/
third_party/dist/
third_party/prefix/
prefix/
third_party/downloads/

# Editors
.DS_Store
.idea/
.vscode/
*.swp
