+/***********************************************************************
+ *           add_main_image_reserved_area
+ *
+ * Register the window the main executable reserves for itself.
+ *
+ * Wine maps a PE image at its ImageBase when that address is free, and the load
+ * test asks for 0x140000000. On this platform the loader is a Mach-O executable
+ * with a __PAGEZERO segment, and the run measured the loader's layout:
+ *
+ *   --- no low-address flags: pagezero=0x0 size=0x0000000100000000 text=0x100000000
+ *
+ * 4GB of pagezero is a window that is not mapped and that slides with the image,
+ * and inside it this kernel neither maps nor changes protections. Two addresses
+ * from the runs are in it: a fixed mapping at 0x100000000 came back
+ * KERN_INVALID_ADDRESS, and mprotect at 0x140000000 came back EACCES, which left
+ * the PE's own .text section unable to be made executable.
+ *
+ * Wine learns its reserved areas from the preloader, which is not used on 64-bit
+ * and is not used here, so with nothing registered Wine chooses an address inside
+ * a window the kernel will not let it use. This registers that window.
+ *
+ * It is read from the executable's own header rather than assumed: the slide comes
+ * from dyld, so these are the addresses in this process, not the ones the linker
+ * printed. Address and size are rounded to the host page because that is what the
+ * reserved area list requires. */
+static void add_main_image_reserved_area( void )
+{
+    const struct mach_header_64 *header = (const struct mach_header_64 *)_dyld_get_image_header( 0 );
+    const struct load_command *cmd;
+    intptr_t slide = _dyld_get_image_vmaddr_slide( 0 );
+    const char *ptr;
+    UINT i;
+
+    if (!header || header->magic != MH_MAGIC_64) return;
+
+    ptr = (const char *)(header + 1);
+    for (i = 0; i < header->ncmds; i++)
+    {
+        cmd = (const struct load_command *)ptr;
+        if (cmd->cmdsize < sizeof(*cmd)) break;
+        if (cmd->cmd == LC_SEGMENT_64)
+        {
+            const struct segment_command_64 *seg = (const struct segment_command_64 *)ptr;
+
+            if (!strcmp( seg->segname, "__PAGEZERO" ) && seg->vmsize)
+            {
+                void *addr = ROUND_ADDR( (void *)(UINT_PTR)(seg->vmaddr + slide), host_page_mask );
+                SIZE_T size = ROUND_SIZE( 0, (SIZE_T)seg->vmsize, host_page_mask );
+
+                if (size && (UINT_PTR)addr < (UINT_PTR)user_space_limit)
+                {
+                    mmap_add_reserved_area( addr, size );
+                    ERR( "arm64 main image window: %p-%p registered as reserved\n",
+                         addr, (char *)addr + size );
+                }
+            }
+        }
+        ptr += cmd->cmdsize;
+    }
+}
+
+/***********************************************************************
+ *           describe_mach_region
+ *
+ * What the kernel says about the region containing an address, for the case where
+ * Wine could not change its protection. It tells the two possible answers apart:
+ * the address is not mapped at all, or it is mapped and the kernel will not change
+ * what it is -- which is what a window reserved for the main executable looks like
+ * from inside the process. mach_vm_region leaves the start of the next region
+ * behind when the address is not mapped, so the failure case prints that too. */
+static void describe_mach_region( void *addr )
+{
+    mach_vm_address_t base = (mach_vm_address_t)(UINT_PTR)addr;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t ret;
+
+    ret = mach_vm_region( mach_task_self(), &base, &size, VM_REGION_BASIC_INFO_64,
+                          (vm_region_info_t)&info, &count, &object );
+    if (ret != KERN_SUCCESS)
+        ERR( "arm64 region at %p: not mapped (mach ret %d), next region at %p\n",
+             addr, ret, (void *)(UINT_PTR)base );
+    else
+        ERR( "arm64 region at %p: mapped %p-%p, protection %#x, maximum %#x\n",
+             addr, (void *)(UINT_PTR)base, (void *)(UINT_PTR)(base + size),
+             (unsigned int)info.protection, (unsigned int)info.max_protection );
+}
+#else
+static void add_main_image_reserved_area( void ) { }
+static void describe_mach_region( void *addr ) { }
+#endif
 
