diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -198,7 +198,21 @@
 static struct file_view *arm64ec_view;
 
 ULONG_PTR user_space_wow_limit = 0;
+/* Windows puts KUSER_SHARED_DATA at 0x7ffe0000, below the 4GB line. On x86_64
+ * macOS Wine reserves that whole range for itself with zerofill sections inside
+ * the loader's own image, so the address exists. macOS on Apple Silicon grants a
+ * process no address below 4GB at all: tests/wine/reserve_probe.c reports EINVAL
+ * for 0x1000 and ENOMEM for 0x7ffe0000 on the machine this was measured on. So
+ * the address is a runtime value on this platform rather than a constant.
+ * Wine's own virtual_init_user_shared_data() maps this same section wherever the
+ * kernel chooses too, so a fixed address is not something Wine's code needs in
+ * order to work. Windows binaries that hardcode 0x7ffe0000 are the cost of the
+ * platform, recorded in docs/wine-arm64-address-space.md. */
+#if defined(__APPLE__) && defined(__aarch64__)
+struct _KUSER_SHARED_DATA *user_shared_data;
+#else
 struct _KUSER_SHARED_DATA *user_shared_data = (void *)0x7ffe0000;
+#endif
 
 /* TEB allocation blocks */
 static void *teb_block;
@@ -752,11 +766,42 @@
 
 #else
 
+#if defined(__APPLE__) && defined(__aarch64__)
+    /* The two reservations below that lie under the 4GB line cannot be made here:
+     * macOS on Apple Silicon has no address space there, which is why the shared
+     * user data page inside them was unmappable and the load test stopped at
+     * "map_fixed_area out of memory for 0x7ffe0000-0x7ffe1000", c0000017.
+     *
+     * The page is reserved at Wine's own top-down base instead. That address is
+     * not invented here: it is the one Wine already reserves its top-down area at
+     * on macOS (configure.ac, -segaddr,WINE_TOP_DOWN,0x7ff000000000), and
+     * tests/wine/reserve_probe.c measured this platform granting it. Letting the
+     * kernel choose an address instead was tried and does not work: the kernel
+     * places it at or above host_addr_space_limit, 0x7ffffe000000, and map_view
+     * refuses that with STATUS_CONFLICTING_ADDRESSES, c0000018, which is the
+     * failure this revision replaces. Below the 4GB line the platform has nothing
+     * at all, and above host_addr_space_limit Wine will not map. Wine's own
+     * virtual_init_user_shared_data() maps this same section wherever the kernel
+     * chooses, so a fixed address is not something Wine's code needs to work. */
+    {
+        void *page = mmap( (void *)0x7ff000000000, host_page_size, PROT_NONE,
+                           MAP_FIXED | MAP_PRIVATE | MAP_ANON, -1, 0 );
+
+        if (page == MAP_FAILED)
+        {
+            ERR( "failed to reserve the page for the shared user data\n" );
+            exit( 1 );
+        }
+        user_shared_data = page;
+        WARN( "shared user data page at %p\n", page );
+    }
+#else
     if (preload_info) return;
     /* if we don't have a preloader, try to reserve the space now */
     reserve_area( (void *)0x000000010000, (void *)0x000068000000 );
     reserve_area( (void *)0x00007f000000, (void *)0x00007fff0000 );
     reserve_area( (void *)0x7ffffe000000, (void *)0x7fffffff0000 );
+#endif
 
 #endif
 }
