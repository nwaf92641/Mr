diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -615,7 +615,31 @@
     }
     else
     {
-        errno = (ret == KERN_NO_SPACE ? EEXIST : ENOMEM);
+        /* Which failures mean "not this address" is measured, not assumed. Two runs
+         * printed the values for the two cases that matter on this platform:
+         *   mach ret 3 (KERN_NO_SPACE) at 0x1012d0000-0x1013e0000, a range occupied
+         *                              by the loader's own mappings
+         *   mach ret 1 (KERN_INVALID_ADDRESS) at 0x100000000-0x100030000, where the
+         *                              next mapped region is at 0x100450000, so the
+         *                              address is not available for a fixed mapping
+         *                              even though nothing is mapped in it
+         * Wine turned the first into ENOMEM through the ternary this replaces and the
+         * second into ENOMEM unconditionally, and try_map_free_area() stops at any
+         * failure that is not EEXIST instead of stepping on. A process with hundreds
+         * of free areas above the loader therefore reported as out of memory:
+         *   err:virtual:try_map_free_area mmap() error Cannot allocate memory,
+         *   range 0x100000000-0x100030000, unix_prot 0.
+         * The three address-related refusals all mean "this address is not usable",
+         * which is what EEXIST already means to that loop. Anything else stays ENOMEM
+         * and prints, because that is the case this change has not measured. */
+        if (ret == KERN_NO_SPACE || ret == KERN_INVALID_ADDRESS || ret == KERN_PROTECTION_FAILURE)
+            errno = EEXIST;
+        else
+        {
+            errno = ENOMEM;
+            ERR( "arm64 fixed map gave up: mach ret %d, range %p-%p\n",
+                 ret, start, (char *)start + size );
+        }
         ptr = MAP_FAILED;
     }
 #else
@@ -3700,6 +3724,31 @@
         for (i = 0; (*preload_info)[i].size; i++)
             mmap_add_reserved_area( (*preload_info)[i].addr, (*preload_info)[i].size );
 
+#if defined(__APPLE__) && defined(__aarch64__)
+    /* Where the Windows shared user data page lives on this platform, set before
+     * mmap_init() because this is the one place every build of this file compiles.
+     *
+     * Windows puts KUSER_SHARED_DATA at 0x7ffe0000, below the 4GB line. On x86_64
+     * macOS Wine reserves that whole range for itself with zerofill sections in the
+     * loader's own image; configure.ac gives that reservation to x86_64 only and
+     * loader/main.c compiles its own out on arm64, so on Apple Silicon Wine reserves
+     * nothing and asks for an address macOS does not have. Measured by
+     * tests/wine/reserve_probe.c: 0x7ffe0000 fails with ENOMEM, the low 8GB with
+     * EINVAL, the high area is granted.
+     *
+     * So the page is moved to Wine's own top-down base, the address configure.ac
+     * already names on macOS (-segaddr,WINE_TOP_DOWN,0x7ff000000000) and the one the
+     * probe measured this platform granting.
+     *
+     * It is deliberately not mapped here. The first attempt reserved it with mmap,
+     * and map_fixed_area() then refused it with STATUS_CONFLICTING_ADDRESSES -- not
+     * from the limit checks, which the line below shows passing, but from
+     * anon_mmap_tryfixed() finding the range already taken and reporting EEXIST. The
+     * address has to be free for Wine to map its page into it, so it is left free. */
+    user_shared_data = (void *)0x7ff000000000;
+    ERR( "arm64 shared user data page: %p (host limit %p, user limit %p, as limit %p)\n",
+         user_shared_data, host_addr_space_limit, user_space_limit, address_space_limit );
+#endif
     mmap_init( preload_info ? *preload_info : NULL );
 
     if ((preload = getenv("WINEPRELOADRESERVE")))
