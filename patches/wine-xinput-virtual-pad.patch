+/* Its keystroke replay is check_for_keystroke_unlocked(), the HID path's own
+ * transition tracker, which is defined below. */
+static DWORD check_for_keystroke_unlocked(struct xinput_controller *controller, const DWORD index,
+                                          XINPUT_KEYSTROKE *keystroke);
+
+/* -------------------------------------------------------------------------
+ * Madeira: the app's virtual controller.
+ *
+ * The app publishes one merged frame -- on-screen pad plus a paired
+ * Bluetooth/MFi pad -- and this module serves it as player 0, through the
+ * same XINPUT_STATE / XINPUT_KEYSTROKE shapes a HID pad produces, so a game
+ * cannot tell the two apart. It takes precedence over a HID pad in slot 0,
+ * which only matters in a build where both can exist; on iOS nothing else
+ * publishes an XInput device at all.
+ *
+ * Everything here fails closed: on a build whose xinput1_4 has no unix table
+ * registered (upstream Wine, or an app that never calls
+ * madeira_xinput_publish), __wine_init_unix_call() fails in DllMain and this
+ * module behaves exactly as upstream does.
+ * ------------------------------------------------------------------------- */
+
+static BOOL madeira_pad_available;
+static struct xinput_controller madeira_pad_controller; /* .state, .last_keystroke only */
+static CRITICAL_SECTION madeira_pad_crit;
+
+static BOOL madeira_pad_refresh(void)
+{
+    struct madeira_pad_state state;
+    XINPUT_GAMEPAD *pad = &madeira_pad_controller.state.Gamepad;
+
+    if (!madeira_pad_available) return FALSE;
+
+    memset(&state, 0, sizeof(state));
+    if (WINE_UNIX_CALL(madeira_pad_get_state, &state)) return FALSE;
+
+    madeira_pad_controller.state.dwPacketNumber = state.packet;
+    pad->wButtons = state.buttons;
+    pad->bLeftTrigger = state.left_trigger;
+    pad->bRightTrigger = state.right_trigger;
+    pad->sThumbLX = state.thumb_lx;
+    pad->sThumbLY = state.thumb_ly;
+    pad->sThumbRX = state.thumb_rx;
+    pad->sThumbRY = state.thumb_ry;
+    return TRUE;
+}
+
+/* TRUE while the app has a controller in player slot 0. */
+static BOOL madeira_pad_present(DWORD index)
+{
+    BOOL present;
+
+    if (index != 0 || !madeira_pad_available) return FALSE;
+
+    EnterCriticalSection(&madeira_pad_crit);
+    present = madeira_pad_refresh();
+    LeaveCriticalSection(&madeira_pad_crit);
+    return present;
+}
+
+static BOOL madeira_pad_state(DWORD index, XINPUT_STATE *state)
+{
+    if (index != 0 || !state || !madeira_pad_available) return FALSE;
+
+    EnterCriticalSection(&madeira_pad_crit);
+    if (!madeira_pad_refresh())
+    {
+        LeaveCriticalSection(&madeira_pad_crit);
+        return FALSE;
+    }
+    *state = madeira_pad_controller.state;
+    LeaveCriticalSection(&madeira_pad_crit);
+    return TRUE;
+}
+
+/* XUSER_INDEX_ANY maps to slot 0: the app's pad is the only slot it fills. */
+static BOOL madeira_pad_keystroke(DWORD index, XINPUT_KEYSTROKE *keystroke)
+{
+    BOOL found;
+
+    if ((index != 0 && index != XUSER_INDEX_ANY) || !madeira_pad_available) return FALSE;
+
+    EnterCriticalSection(&madeira_pad_crit);
+    found = madeira_pad_refresh() &&
+            check_for_keystroke_unlocked(&madeira_pad_controller, 0, keystroke) == ERROR_SUCCESS;
+    LeaveCriticalSection(&madeira_pad_crit);
+    return found;
+}
+
+static BOOL madeira_pad_rumble(DWORD index, const XINPUT_VIBRATION *vibration)
+{
+    struct madeira_pad_rumble rumble;
+
+    if (index != 0 || !vibration || !madeira_pad_present(index)) return FALSE;
+
+    rumble.left = vibration->wLeftMotorSpeed;
+    rumble.right = vibration->wRightMotorSpeed;
+    WINE_UNIX_CALL(madeira_pad_set_rumble, &rumble);
+    return TRUE;
+}
+
+static BOOL madeira_pad_battery(DWORD index, XINPUT_BATTERY_INFORMATION *battery)
+{
+    if (!battery || !madeira_pad_present(index)) return FALSE;
+
+    memset(battery, 0, sizeof(*battery));
+    battery->BatteryType = BATTERY_TYPE_WIRED;
+    battery->BatteryLevel = BATTERY_LEVEL_FULL;
+    return TRUE;
+}
+
+/* A full Xbox 360 pad's capabilities, ids included: plenty of titles key
+ * behaviour off VendorId/ProductId, and 0x045e/0x028e is the pad they expect.
+ * The masks mirror what controller_check_caps() derives from a real pad's HID
+ * descriptor (0xffff buttons, one full-scale trigger and stick per axis). */
+static BOOL madeira_pad_caps(DWORD index, XINPUT_CAPABILITIES_EX *caps)
+{
+    if (index != 0 || !caps || !madeira_pad_present(index)) return FALSE;
+
+    memset(caps, 0, sizeof(*caps));
+    caps->Capabilities.Type = XINPUT_DEVTYPE_GAMEPAD;
+    caps->Capabilities.SubType = XINPUT_DEVSUBTYPE_GAMEPAD;
+    caps->Capabilities.Flags = XINPUT_CAPS_FFB_SUPPORTED;
+    caps->Capabilities.Gamepad.wButtons = 0xffff;
+    caps->Capabilities.Gamepad.bLeftTrigger = 0xff;
+    caps->Capabilities.Gamepad.bRightTrigger = 0xff;
+    caps->Capabilities.Gamepad.sThumbLX = 0xffff;
+    caps->Capabilities.Gamepad.sThumbLY = 0xffff;
+    caps->Capabilities.Gamepad.sThumbRX = 0xffff;
+    caps->Capabilities.Gamepad.sThumbRY = 0xffff;
+    caps->Capabilities.Vibration.wLeftMotorSpeed = 0xff;
+    caps->Capabilities.Vibration.wRightMotorSpeed = 0xff;
+    caps->VendorId = 0x045e;
+    caps->ProductId = 0x028e;
+    caps->VersionNumber = 0x0114;
+    return TRUE;
+}
+
