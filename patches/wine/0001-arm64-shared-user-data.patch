diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3700,6 +3700,32 @@
         for (i = 0; (*preload_info)[i].size; i++)
             mmap_add_reserved_area( (*preload_info)[i].addr, (*preload_info)[i].size );
 
+#if defined(__APPLE__) && defined(__aarch64__)
+    /* Where the Windows shared user data page lives on this platform, set before
+     * mmap_init() because this is the one place every build of this file compiles.
+     *
+     * Windows puts KUSER_SHARED_DATA at 0x7ffe0000, below the 4GB line. On x86_64
+     * macOS Wine reserves that whole range for itself with zerofill sections in
+     * the loader's own image; configure.ac gives that reservation to x86_64 only
+     * and loader/main.c compiles its own out on arm64, so on Apple Silicon Wine
+     * reserves nothing and asks for an address macOS does not have. Measured by
+     * tests/wine/reserve_probe.c: 0x7ffe0000 fails with ENOMEM, the low 8GB with
+     * EINVAL, the high area is granted.
+     *
+     * So the page is moved to Wine's own top-down base, the address configure.ac
+     * already names on macOS (-segaddr,WINE_TOP_DOWN,0x7ff000000000) and the one
+     * the probe measured this platform granting.
+     *
+     * It is deliberately not mapped here. The first attempt reserved it with
+     * mmap, and map_fixed_area() then refused it with STATUS_CONFLICTING_ADDRESSES
+     * -- not from the limit checks, which the line below shows passing, but from
+     * anon_mmap_tryfixed() finding the range already taken and reporting EEXIST.
+     * The address has to be free for Wine to map its page into it, and it is left
+     * free. */
+    user_shared_data = (void *)0x7ff000000000;
+    ERR( "arm64 shared user data page: %p (host limit %p, user limit %p, as limit %p)\n",
+         user_shared_data, host_addr_space_limit, user_space_limit, address_space_limit );
+#endif
     mmap_init( preload_info ? *preload_info : NULL );
 
     if ((preload = getenv("WINEPRELOADRESERVE")))
